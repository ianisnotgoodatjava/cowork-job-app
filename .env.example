GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Applications

# Meta Model API key for Muse Spark. Get one at https://dev.meta.ai
# Only needed for `auto-draft`, `find-jobs` and `schedule-followups --draft`,
# which research and write with a model. Everything else runs without it.
MODEL_API_KEY=your_meta_model_api_key_here
# Optional: a different Muse model. Defaults to muse-spark-1.3.
# MUSE_MODEL=muse-spark-1.3

# Your own addresses, comma-separated. Used to tell your messages from other
# people's in a thread. Falls back to profile.email in resume_bank.json.
OWN_EMAIL=you@example.com
# Optional: your display name, if mail goes out under more than one address.
OWN_NAME=Your Name
