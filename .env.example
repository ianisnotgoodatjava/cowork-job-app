GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Applications

# Only needed for `cli.py auto-draft`, which researches a contact and writes a
# finished outreach email. Everything else in this project runs without it.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your own addresses, comma-separated. Used to tell your messages from other
# people's in a thread. Falls back to profile.email in resume_bank.json.
OWN_EMAIL=you@example.com
# Optional: your display name, if mail goes out under more than one address.
OWN_NAME=Your Name
